<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="agentic_idempotency" resource="default" engine="innodb" comment="Idempotent request records, partitioned by caller scope">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="scope" nullable="false" length="32" comment="Which caller owns this row"/>
        <column xsi:type="varchar" name="idempotency_key" nullable="false" length="255" comment="Key the caller supplied"/>
        <column xsi:type="varchar" name="request_hash" nullable="false" length="64" comment="Canonical hash of the request the key was claimed for"/>
        <column xsi:type="int" name="response_status" nullable="true" unsigned="true" comment="Response status (NULL while the claim is in flight)"/>
        <column xsi:type="text" name="response_body" nullable="true" comment="Response body, exactly as it must be replayed"/>
        <column xsi:type="datetime" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="datetime" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="AGENTIC_IDEMPOTENCY_SCOPE_IDEMPOTENCY_KEY">
            <column name="scope"/>
            <column name="idempotency_key"/>
        </constraint>
        <index referenceId="AGENTIC_IDEMPOTENCY_CREATED_AT_IDX" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>

    <table name="agentic_webhook_delivery" resource="default" engine="innodb" comment="Outbound webhook deliveries awaiting or past their attempt">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="scope" nullable="false" length="32" comment="Which caller owns this row"/>
        <column xsi:type="varchar" name="url" nullable="false" length="2048" comment="Receiver URL"/>
        <column xsi:type="mediumtext" name="payload" nullable="false" comment="Body to send, signed at send time"/>
        <column xsi:type="varchar" name="reference" nullable="false" length="255" comment="Caller's correlation id, sent as Request-Id"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0" comment="Attempts made so far"/>
        <column xsi:type="datetime" name="next_attempt_at" nullable="false" comment="Not attempted before this time"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16" default="pending" comment="pending, delivered or failed"/>
        <column xsi:type="text" name="last_error" nullable="true" comment="Why the last attempt did not deliver"/>
        <column xsi:type="datetime" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="datetime" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="AGENTIC_WEBHOOK_DELIVERY_SCOPE_STATUS_NEXT_ATTEMPT_AT_IDX" indexType="btree">
            <column name="scope"/>
            <column name="status"/>
            <column name="next_attempt_at"/>
        </index>
    </table>

    <table name="agentic_checkout_order_link" resource="default" engine="innodb" comment="Which order a checkout session produced">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="scope" nullable="false" length="32" comment="Which caller owns this row"/>
        <column xsi:type="varchar" name="session_id" nullable="false" length="255" comment="Session identifier the caller issued"/>
        <column xsi:type="int" name="quote_id" nullable="true" unsigned="true" comment="Quote the session was held on"/>
        <column xsi:type="int" name="order_id" nullable="true" unsigned="true" comment="Order that was placed, NULL until placement"/>
        <column xsi:type="datetime" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="datetime" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="AGENTIC_CHECKOUT_ORDER_LINK_SCOPE_SESSION_ID">
            <column name="scope"/>
            <column name="session_id"/>
        </constraint>
        <!-- The order cascades because a deleted order makes the link meaningless; the quote nulls
             because quote cleanup routinely removes quotes whose orders are still live. -->
        <constraint xsi:type="foreign" referenceId="AGENTIC_CHECKOUT_ORDER_LINK_QUOTE_ID_QUOTE_ENTITY_ID" table="agentic_checkout_order_link" column="quote_id" referenceTable="quote" referenceColumn="entity_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign" referenceId="AGENTIC_CHECKOUT_ORDER_LINK_ORDER_ID_SALES_ORDER_ENTITY_ID" table="agentic_checkout_order_link" column="order_id" referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
    <table name="agentic_signing_key" resource="default" engine="innodb" comment="Key pairs used to sign outbound messages">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="scope" nullable="false" length="32" comment="Which caller owns this row"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0" comment="Store the key belongs to"/>
        <column xsi:type="varchar" name="kid" nullable="false" length="64" comment="Key id a verifier matches against the published key"/>
        <column xsi:type="text" name="public_jwk" nullable="false" comment="Public half, as published in the discovery profile"/>
        <!-- Encrypted, so a database dump does not hand over the ability to sign as this merchant. -->
        <column xsi:type="text" name="private_key" nullable="false" comment="Private half, encrypted at rest"/>
        <column xsi:type="boolean" name="is_active" nullable="false" default="1" comment="Whether new messages may be signed with this key"/>
        <column xsi:type="datetime" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="AGENTIC_SIGNING_KEY_SCOPE_STORE_ID_KID">
            <column name="scope"/>
            <column name="store_id"/>
            <column name="kid"/>
        </constraint>
        <index referenceId="AGENTIC_SIGNING_KEY_SCOPE_STORE_ID_IS_ACTIVE" indexType="btree">
            <column name="scope"/>
            <column name="store_id"/>
            <column name="is_active"/>
        </index>
    </table>
</schema>
